[Unit]
Description=Ken research - verify one artist song recordings
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=kenresearch
Group=kenresearch
WorkingDirectory=/opt/ken-song-api
ExecStart=/opt/ken-song-api/.venv/bin/python /opt/ken-song-api/server/research_worker.py --lane songs --max-items 25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=180M
TasksMax=40
TimeoutStartSec=15min
Nice=10
